# =============================================================================
# AkkunSpace — environment variables template
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored — NEVER commit it.
#
# 隐私说明：PERSONAL_BIRTHDAY / SITE_LAUNCHED_AT 等私人事件相关变量
# 只在服务端读取，永远不会出现在客户端 bundle 或 API 响应中。
# 留空 = 对应事件不触发（站点照常运行）。
# =============================================================================

# --- Supabase (required for guestbook / likes / view counts) ---
# Public client (browser-safe, RLS-protected):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side admin client (NEVER expose to the browser):
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.akkun.online

# --- Personal events (optional, server-side only) ---
# Your public-calendar birthday, MM-DD format. Leave empty to disable the birthday event.
PERSONAL_BIRTHDAY=
# Site first launch date, YYYY-MM-DD format. Used to compute site anniversaries.
SITE_LAUNCHED_AT=

# --- Cron / Bili WBI (if applicable) ---
# CRON_SECRET=

# =============================================================================
# Email delivery for OTP login (optional)
# Set ONE provider. Uncomment the block you use.
# If none is configured: codes are only logged server-side, and echoed to the
# UI in non-production so you can still test locally.
# =============================================================================




# --- Option B: Resend HTTP API ---
# OTP_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# OTP_EMAIL_FROM=no-reply@yourdomain.com
